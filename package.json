    "toast"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buggypather/notify-me-claude"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
