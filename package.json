  "description": "Desktop notifications when Claude Code starts working, needs your permission, replies while still working, or finishes.",
  "type": "module",
  "bin": {
    "notify-me-claude": "dist/cli.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "hooks",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "engines": {
